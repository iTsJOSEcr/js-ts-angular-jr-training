{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./week-03",
    "outDir": "./dist/week-03",

    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,

    "sourceMap": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },

  "include": [
    "week-03/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}
